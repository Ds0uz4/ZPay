# LM Studio OpenAI-compatible endpoint (start the Local Server in LM Studio and load a model)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=prism-ml/bonsai-27b
LM_STUDIO_TEMPERATURE=0.2
LM_STUDIO_MAX_TOKENS=4096
LM_STUDIO_TIMEOUT_S=600

# Web server
PORT=8000

# RAG knowledge base (BM25 over .txt/.md/.yaml files) and outputs
RAG_DOCS_DIR=docs/ingested
RAG_TOP_K=6
ARTIFACTS_DIR=artifacts
